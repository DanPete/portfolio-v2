---
import Welcome from '~/components/Welcome.astro';
import Layout from '~/layouts/Layout.astro';
import ComingSoon from '~/components/ComingSoon.astro';
import { loadSanityQuery } from '~/lib/loadSanityQuery';
import { INDEX_SETTINGS_QUERY } from '~/queries/indexSettings';
import type { INDEX_SETTINGS_QUERYResult } from 'sanity.generated';

const { data } = await loadSanityQuery<INDEX_SETTINGS_QUERYResult>({
  query: INDEX_SETTINGS_QUERY,
});

const { maintenanceMode, comingSoonHeading, comingSoonMessage } = data ?? {};
---

<Layout>
  {
    maintenanceMode ? (
      <ComingSoon heading={comingSoonHeading} message={comingSoonMessage} />
    ) : (
      <Welcome />
    )
  }
</Layout>
